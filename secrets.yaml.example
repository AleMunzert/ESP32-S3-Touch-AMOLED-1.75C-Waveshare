# Vorlage fuer die eigene secrets.yaml (NICHT mit echten Werten einchecken).
# Kopieren nach secrets.yaml und anpassen.

wifi_ssid: "MEIN-WLAN"
wifi_password: "MEIN-WLAN-PASSWORT"

# Eigener API-Schluessel, erzeugen z.B. mit: openssl rand -base64 32
api_encryption_key: "HIER-EIGENEN-BASE64-SCHLUESSEL-EINTRAGEN"

# Feste IP des Satelliten und Gateway/DNS im selben Netz
static_ip: "192.168.1.50"
gateway: "192.168.1.1"

# Passwort fuer den Fallback-Hotspot (mind. 8 Zeichen)
ap_password: "HIER-EIGENES-PASSWORT-EINTRAGEN"
